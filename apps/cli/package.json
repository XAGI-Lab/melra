{
  "name": "@melra/cli",
  "version": "0.4.0-alpha.2",
  "description": "Open-source local runtime for MCP and CLI agent tools, with policy checks, scoped approvals, outcome verification, and interrupted-write recovery.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "agent-runtime",
    "agent-security",
    "tool-execution",
    "local-first",
    "durable-execution",
    "verification"
  ],
  "mcpName": "io.github.XAGI-Lab/melra",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XAGI-Lab/melra.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/XAGI-Lab/melra#readme",
  "bugs": "https://github.com/XAGI-Lab/melra/issues",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "bin": {
    "melra": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "LICENSES/Apache-2.0.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js dist/index.js",
    "clean": "rm -rf dist",
    "start": "tsx src/index.ts",
    "pack:check": "npm pack --dry-run",
    "test": "vitest run --testTimeout=20000",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@melra/browser-runtime": "workspace:*",
    "@melra/computer-runtime": "workspace:*",
    "@melra/policy-core": "workspace:*",
    "@melra/protocol": "workspace:*",
    "@melra/runtime-core": "workspace:*",
    "@melra/server": "workspace:*",
    "@melra/storage-sqlite": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
