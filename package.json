{
  "name": "melra",
  "version": "0.3.0-alpha.9",
  "private": true,
  "description": "MELRA — Modular Execution Layer for Reliable Autonomy: an agent-independent autonomy kernel for governed, durable, verifiable autonomous execution.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.12",
      "hono": "^4.12.34",
      "fast-uri": "^3.1.5"
    }
  },
  "scripts": {
    "build": "node scripts/run-recursive.mjs build",
    "clean": "pnpm -r clean",
    "dev": "pnpm --filter @melra/cli dev",
    "melra": "tsx apps/cli/src/index.ts",
    "e2e": "pnpm --filter @melra/server test:e2e",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "registry:smoke": "node scripts/registry-smoke.mjs",
    "benchmark:core": "pnpm build && node scripts/bench-core.mjs",
    "benchmark:locomo": "pnpm --filter @melra/memory build && node scripts/bench-locomo.mjs",
    "benchmark:browser:check": "uv run --project benchmarks/browser-agent --group test ruff check benchmarks/browser-agent && uv run --project benchmarks/browser-agent --group test pytest benchmarks/browser-agent",
    "benchmark:browser:verify-upstream": "uv run --project benchmarks/browser-agent melra-browser-bench verify-upstream",
    "evals": "pnpm --filter @melra/evals evaluate",
    "python:check": "uv run --project sdk-py ruff check sdk-py && uv run --project sdk-py pytest sdk-py",
    "python:audit": "node scripts/python-audit.mjs",
    "security:audit": "pnpm audit --prod --audit-level moderate && pnpm python:audit",
    "test": "node scripts/run-recursive.mjs test",
    "test:peak-rss": "node scripts/peak-rss.mjs -- pnpm test",
    "typecheck": "pnpm build && node scripts/run-recursive.mjs typecheck",
    "versions:check": "node scripts/check-versions.mjs",
    "versions:set": "node scripts/set-version.mjs",
    "check": "pnpm versions:check && pnpm typecheck && node scripts/check-readme-examples.mjs && pnpm test && pnpm python:check",
    "pack:check": "pnpm build && pnpm --dir apps/cli pack:check",
    "readme:check": "pnpm build && node scripts/check-readme-examples.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "22.20.1",
    "playwright-core": "1.62.0",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
