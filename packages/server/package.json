{
  "name": "@melra/server",
  "version": "0.3.0-alpha.17",
  "description": "MELRA autonomy kernel with MCP and loopback HTTP interfaces.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XAGI-Lab/melra.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/XAGI-Lab/melra#readme",
  "bugs": "https://github.com/XAGI-Lab/melra/issues",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "default": "./dist/kernel.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run --testTimeout=30000 --hookTimeout=30000",
    "test:e2e": "vitest run test/e2e.test.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@melra/browser-runtime": "workspace:*",
    "@melra/computer-runtime": "workspace:*",
    "@melra/file-runtime": "workspace:*",
    "@melra/http-runtime": "workspace:*",
    "@melra/memory": "workspace:*",
    "@melra/policy-core": "workspace:*",
    "@melra/protocol": "workspace:*",
    "@melra/runtime-core": "workspace:*",
    "@melra/storage-sqlite": "workspace:*",
    "@melra/terminal-runtime": "workspace:*",
    "@melra/verifier-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  }
}
