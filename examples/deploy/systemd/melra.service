# MELRA as a hardened systemd service on a Unix socket (#52).
#
# The kernel enforces every restriction below; MELRA only has to run inside
# them. `melra doctor` under the same settings reports what took effect:
#   isolation  no capabilities, no_new_privs, seccomp filter, read-only root
#
# Install (system service, one per user and workspace):
#   sudo install -m 0644 melra.service /etc/systemd/system/melra@.service
#   sudo systemctl enable --now melra@$USER
# Then point an SDK or a socket-aware client at /run/melra-$USER/melra.sock.
# Enforced mode runs every command in a bubblewrap sandbox of its own and
# refuses to start without one: install bubblewrap, and on Ubuntu 24.04 let
# unprivileged programs make user namespaces (`melra doctor` names how).
# `scripts/systemd-smoke.mjs` runs `doctor` under the [Service] settings here,
# so this file and what CI checks cannot drift apart.

[Unit]
Description=MELRA autonomy kernel for the effects %i routes through it
After=network-online.target

[Service]
Type=simple
User=%i
# Edit to the project MELRA may act on, and where it keeps its records.
Environment=MELRA_WORKSPACE=/home/%i/project
Environment=MELRA_HOME=/home/%i/.melra
Environment=MELRA_MODE=enforced
ExecStart=/usr/bin/env melra serve --socket /run/melra-%i/melra.sock
RuntimeDirectory=melra-%i
RuntimeDirectoryMode=0700
Restart=on-failure

# --- hardening ----------------------------------------------------------------
# No privilege at all, and no way to regain any (setuid, file capabilities).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# The whole filesystem read-only except the workspace and MELRA's data.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/project /home/%i/.melra
PrivateTmp=yes
PrivateDevices=yes
# Not ProtectKernelTunables=, ProtectKernelLogs= or ProtectHostname=: each
# mounts over part of /proc (ProtectHostname its hostname files, once the
# options above give the service a mount namespace), and a command's sandbox
# then cannot mount a /proc of its own.
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
# Only the namespaces bubblewrap makes for each command: its own user, mounts,
# process IDs and an empty network.
RestrictNamespaces=user mnt pid net
LockPersonality=yes
# Unix sockets for the transport, IP for the HTTP and browser adapters, and
# netlink for bubblewrap to bring up loopback in a command's empty network.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# A seccomp filter: the syscalls an ordinary service needs, and the mount
# calls bubblewrap builds each command's view of the filesystem with.
SystemCallFilter=@system-service @mount
SystemCallArchitectures=native
# Deliberately absent: MemoryDenyWriteExecute=yes. V8's JIT writes and then
# executes code, so Node exits at startup under it.
UMask=0077

[Install]
WantedBy=multi-user.target
