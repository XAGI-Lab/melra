{
  "schemaVersion": "1.0.0",
  "id": "desktop-two-deletes",
  "description": "Two buttons named Delete, in the shape the macOS adapter reports them. The click step is present on purpose: a scenario using this desktop must fail because the target could not be resolved, not because the recording ran out.",
  "capabilities": {
    "platform": "darwin",
    "adapter": "macos-native",
    "available": true,
    "screenshot": true,
    "pointer": true,
    "keyboard": true,
    "scroll": true,
    "inspect": true,
    "elements": true,
    "drag": true,
    "coordinateSpaces": ["normalized", "pixel"],
    "limitations": []
  },
  "steps": {
    "inspect": {
      "success": true,
      "action": "inspect",
      "application": "Mail",
      "windowTitle": "Inbox",
      "displayWidth": 1440,
      "displayHeight": 900,
      "secureInput": false,
      "elements": [
        { "role": "AXButton", "name": "Delete", "x": 180, "y": 120, "width": 80, "height": 28 },
        { "role": "AXButton", "name": "Delete", "x": 980, "y": 640, "width": 80, "height": 28 },
        { "role": "AXButton", "name": "Archive", "x": 280, "y": 120, "width": 80, "height": 28 }
      ]
    },
    "click": {
      "success": true,
      "action": "click",
      "coordinateSpace": "pixel",
      "x": 220,
      "y": 134
    }
  }
}
