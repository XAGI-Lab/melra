{
  "name": "@melra/evals",
  "version": "0.3.0-alpha.0",
  "description": "Deterministic safety, execution, crash-recovery, and concurrency evaluations for MELRA.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist results",
    "evaluate": "tsx src/runner.ts",
    "evaluate:durable-core": "node dist/durable-core.js run",
    "summarize:durable-core": "node dist/durable-core.js summarize",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@melra/computer-runtime": "workspace:*",
    "@melra/protocol": "workspace:*",
    "@melra/receipt-schema": "workspace:*",
    "@melra/server": "workspace:*"
  }
}
